diff --git a/Core/Scripts/Gameplay/Interfaces/IEntityMovementDataHandler.cs b/Core/Scripts/Gameplay/Interfaces/IEntityMovementDataHandler.cs
index 0937d249b..33ee64b2b 100644
--- a/Core/Scripts/Gameplay/Interfaces/IEntityMovementDataHandler.cs
+++ b/Core/Scripts/Gameplay/Interfaces/IEntityMovementDataHandler.cs
@@ -16,4 +16,52 @@ namespace MultiplayerARPG
         bool WriteClientState(long writeTimestamp, NetDataWriter writer, out bool shouldSendReliably);
